# Android applicationId (must match the app exactly)
PACKAGE_NAME=com.paicons.selfdevelopment
# Comma-separated subscription product IDs created in Play Console
ALLOWED_PRODUCTS=pro_monthly,pro_yearly
# firestore (production) or memory (local dev/tests only)
STORE=firestore
# RTDN Pub/Sub push authentication (OIDC). Audience = the push endpoint URL you configure.
PUBSUB_AUDIENCE=https://YOUR-SERVICE-URL/v1/rtdn
PUBSUB_SERVICE_ACCOUNT=rtdn-pusher@YOUR-PROJECT.iam.gserviceaccount.com
# Local development only — NEVER set in production.
ALLOW_UNAUTHENTICATED_RTDN=false
PORT=8080
# Credentials: on Cloud Run use the attached service account (no key files).
# Locally: GOOGLE_APPLICATION_CREDENTIALS=/path/to/key.json (never commit it).
