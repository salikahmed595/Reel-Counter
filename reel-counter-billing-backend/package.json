{
  "name": "reel-counter-billing-backend",
  "version": "1.0.0",
  "private": true,
  "description": "Minimal Google Play subscription verification + RTDN service for Reel Counter. Stores no activity data.",
  "type": "module",
  "engines": { "node": ">=20" },
  "main": "dist/server.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "dev": "tsc -p tsconfig.json && STORE=memory ALLOW_UNAUTHENTICATED_RTDN=true node dist/server.js",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@google-cloud/firestore": "^9.3.1",
    "express": "^5.3.0",
    "google-auth-library": "^11.3.0",
    "googleapis": "^185.0.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^22.10.0",
    "typescript": "5.9.3",
    "vitest": "3.2.4"
  }
}
